clear all;
close all;

load('data/grid_ufd.mat', 'X', 'Y');
X_ufd = X; Y_ufd = Y;

load('data/grid_nfd.mat', 'X', 'Y');
X_nfd = X; Y_nfd = Y;

%% grid plot
% Definisci i nodi della griglia

figure;
hold on;

% Linee verticali (costanti in x)
plot(X_ufd', Y_ufd', 'k-', 'LineWidth', 0.1);

% Linee orizzontali (costanti in y)
plot(X_ufd, Y_ufd, 'k-', 'LineWidth', 0.1);

xlabel('x'); ylabel('y');
title('Marching vortex grid');
xlim([X_ufd(1), X_ufd(end)]);
ylim([Y_ufd(1), Y_ufd(end)]);
axis equal;
hold off;

% Linee verticali (costanti in x)
plot(X_nfd', Y_nfd', 'k-', 'LineWidth', 0.1);

% Linee orizzontali (costanti in y)
plot(X_nfd, Y_nfd, 'k-', 'LineWidth', 0.1);

xlabel('x'); ylabel('y');
title('Marching vortex grid');
xlim([X_nfd(1), X_nfd(end)]);
ylim([Y_nfd(1), Y_nfd(end)]);
axis equal;
hold off;